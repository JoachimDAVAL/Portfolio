{
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Garde les variables saisies dans le tableau de bord Cloudflare (BREVO_API_KEY, CONTACT_TO, CONTACT_FROM)
  "keep_vars": true,
  // Seulement www.joachimdaval.dev : pas de copie du site sur workers.dev
  "workers_dev": false,
  "preview_urls": false,
  // Journaux consultables dans le tableau de bord (onglet Logs du Worker)
  "observability": { "enabled": true },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
